{
  "name": "bay-area-seasonality",
  "version": "1.0.0",
  "private": true,
  "description": "A dark PWA for seasonal Bay Area produce",
  "scripts": {
    "dev": "yarn --cwd cloudflare dev",
    "build": "yarn --cwd cloudflare build",
    "deploy": "yarn --cwd cloudflare deploy",
    "check": "node --check app.js && node -e \"JSON.parse(require('fs').readFileSync('data/produce.json'))\""
  }
}
